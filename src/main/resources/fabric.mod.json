{
  "schemaVersion": 1,
  "id": "evoassist",
  "version": "${version}",
  "name": "EvoAssist",
  "description": "Client-side QoL tools for DiamondWorld Prison Evo.",
  "authors": [
    "Konnzy"
  ],
  "contact": {},
  "license": [
    "MIT",
    "Apache-2.0"
  ],
  "icon": "assets/evoassist/icon.png",
